# NASA FIRMS API Credentials
# Obtain your free MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Geographic bounding box for Chennai & surrounding districts: West,South,East,North
DEFAULT_BBOX=79.4,12.2,80.6,13.7

# Default day range for FIRMS area queries (1 to 5)
DEFAULT_DAYS=5

# Server cache time-to-live in seconds (10 min aligns with FIRMS rate limit window)
CACHE_TTL_SECONDS=600

# Server settings
HOST=127.0.0.1
PORT=8000
DEBUG=False
